{
  "ConnectionStrings": {
    "Default": "Data Source=todoapp.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "AutoMigrate": false
  },
  "Jwt": {
    "Issuer": "TodoApp",
    "Audience": "TodoApp.Client",
    "Key": "",
    "ExpiryMinutes": 120
  },
  "Security": {
    "BcryptWorkFactor": 11
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Trash": {
    "RetentionHours": 24,
    "PurgeEnabled": true,
    "IntervalMinutes": 60
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
